# ─── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Set to "true" to skip TLS verification in dev (self-signed certs)
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ─── Database (Supabase Postgres) ─────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES=30d

# ─── Supabase Storage (PDF / DOCX uploads) ────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=Lumex

# ─── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Lumex Research <noreply@lumex.com>
APP_URL=http://localhost:4000

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ─── AI (Gemini) ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── AI (Groq) ───────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key

# ─── Rate Limiting ───────────────────────────────────────────
# Set to "true" to disable rate limiting in dev/test
# SKIP_RATE_LIMIT=true

# ─── Payment (Stripe/Razorpay) — Phase 5 ────────────────────
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
