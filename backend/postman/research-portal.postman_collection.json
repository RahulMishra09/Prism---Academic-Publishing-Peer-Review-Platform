{
  "info": {
    "name": "Research Portal API",
    "description": "Complete API collection for the Lumex Research Portal backend. Import this into Postman, then set the `baseUrl` and `adminEmail`/`adminPassword` variables in your environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",        "value": "http://localhost:5000" },
    { "key": "authToken",      "value": "" },
    { "key": "refreshToken",   "value": "" },
    { "key": "adminToken",     "value": "" },
    { "key": "articleDoi",     "value": "10.1234/test-article" },
    { "key": "articleId",      "value": "" },
    { "key": "submissionId",   "value": "" },
    { "key": "journalId",      "value": "" },
    { "key": "bookId",         "value": "" },
    { "key": "newsId",         "value": "" },
    { "key": "contactId",      "value": "" }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "2. Auth",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) {",
            "  const json = pm.response.json();",
            "  pm.collectionVariables.set('authToken', json.data?.accessToken ?? '');",
            "  pm.collectionVariables.set('refreshToken', json.data?.refreshToken ?? '');",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"TestPass123!\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  const json = pm.response.json();",
            "  pm.collectionVariables.set('authToken', json.data?.accessToken ?? '');",
            "  pm.collectionVariables.set('refreshToken', json.data?.refreshToken ?? '');",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"TestPass123!\"\n}" }
          }
        },
        {
          "name": "Admin Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  const json = pm.response.json();",
            "  pm.collectionVariables.set('adminToken', json.data?.accessToken ?? '');",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"AdminPass123!\"\n}" }
          }
        },
        {
          "name": "Refresh Token",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  const json = pm.response.json();",
            "  pm.collectionVariables.set('authToken', json.data?.accessToken ?? '');",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"testuser@example.com\"\n}" }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "3. Users / Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/users/me"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/users/me",
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Name\",\n  \"bio\": \"Researcher at XYZ University\",\n  \"affiliation\": \"XYZ University\"\n}" }
          }
        },
        {
          "name": "My Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/users/me/dashboard"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/users/me/change-password",
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"TestPass123!\",\n  \"newPassword\": \"NewPass456!\"\n}" }
          }
        },
        {
          "name": "Admin - List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users?page=1&pageSize=20",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Bookmarks",
      "item": [
        {
          "name": "List My Bookmarks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/users/me/bookmarks"
          }
        },
        {
          "name": "Add Bookmark",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/users/me/bookmarks/{{articleId}}"
          }
        },
        {
          "name": "Remove Bookmark",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/users/me/bookmarks/{{articleId}}"
          }
        }
      ]
    },
    {
      "name": "5. Subscriptions",
      "item": [
        {
          "name": "Get My Subscription",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/users/me/subscription"
          }
        },
        {
          "name": "Subscribe",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/users/me/subscription",
            "body": { "mode": "raw", "raw": "{\n  \"plan\": \"MONTHLY\"\n}" }
          }
        },
        {
          "name": "Cancel Subscription",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/users/me/subscription"
          }
        }
      ]
    },
    {
      "name": "6. Articles (Public)",
      "item": [
        {
          "name": "List Articles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/articles?page=1&pageSize=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Article by DOI",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/articles/{{articleDoi}}"
          }
        },
        {
          "name": "Trending Articles (week)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/articles/trending?period=week",
              "query": [{ "key": "period", "value": "week" }]
            }
          }
        },
        {
          "name": "Cite Article (APA)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/articles/{{articleDoi}}/cite?format=apa",
              "query": [{ "key": "format", "value": "apa" }]
            }
          }
        },
        {
          "name": "Cite Article (BibTeX)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/articles/{{articleDoi}}/cite?format=bibtex",
              "query": [{ "key": "format", "value": "bibtex" }]
            }
          }
        },
        {
          "name": "Cite Article (RIS)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/articles/{{articleDoi}}/cite?format=ris",
              "query": [{ "key": "format", "value": "ris" }]
            }
          }
        },
        {
          "name": "Download Article (open access)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/articles/{{articleDoi}}/download"
          }
        },
        {
          "name": "Download Article (paid - with token)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/articles/{{articleDoi}}/download"
          }
        },
        {
          "name": "Get Article Figures",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/articles/{{articleId}}/figures"
          }
        },
        {
          "name": "Get Article Supplementary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/articles/{{articleId}}/supplementary"
          }
        }
      ]
    },
    {
      "name": "7. Articles (Admin)",
      "item": [
        {
          "name": "Admin List All Articles",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/articles/admin/all?page=1&pageSize=20",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Admin Create Article",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) {",
            "  const json = pm.response.json();",
            "  pm.collectionVariables.set('articleId', json.data?.id ?? '');",
            "  pm.collectionVariables.set('articleDoi', json.data?.doi ?? '10.1234/test');",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/articles",
            "body": { "mode": "raw", "raw": "{\n  \"doi\": \"10.1234/test-article-001\",\n  \"title\": \"Test Article for API Testing\",\n  \"abstract\": \"This is a test abstract with enough content to validate the endpoint.\",\n  \"keywords\": [\"test\", \"api\", \"research\"],\n  \"discipline\": \"Computer Science\",\n  \"accessType\": \"OPEN_ACCESS\",\n  \"isPublished\": false\n}" }
          }
        },
        {
          "name": "Admin Update Article",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/articles/{{articleId}}",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated Test Article Title\",\n  \"isPublished\": true\n}" }
          }
        },
        {
          "name": "Admin Add Figure",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/articles/{{articleId}}/figures",
            "body": { "mode": "raw", "raw": "{\n  \"caption\": \"Figure 1: Results overview\",\n  \"url\": \"https://example.com/figures/fig1.png\",\n  \"type\": \"IMAGE\"\n}" }
          }
        },
        {
          "name": "Admin Delete Article",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/articles/{{articleId}}"
          }
        }
      ]
    },
